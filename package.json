{
  "name": "agendafl",
  "version": "1.0.0",
  "description": "FL Agenda — Aplicativo Desktop de Agenda para Estética e Beleza",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "tsc && electron . --enable-logging",
    "build": "tsc && node -e \"fs.cpSync('src/renderer', 'dist/renderer', { recursive: true, filter: (src) => !src.endsWith('.ts') })\"",
    "serve": "node server.js",
    "watch": "tsc --watch"
  },
  "keywords": [
    "electron",
    "agenda",
    "beauty",
    "salon",
    "desktop",
    "typescript"
  ],
  "author": "Davi-Cesar",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.3.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
